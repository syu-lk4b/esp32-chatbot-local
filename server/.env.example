# Shared secret; must match CHAT_TOKEN in firmware include/secrets.h
VOICE_TOKEN=change-me
VOICE_HOST=0.0.0.0
VOICE_PORT=8765
# LLM: "openai" = any OpenAI-compatible server (LM Studio), or "ollama"
LLM_BACKEND=openai
LLM_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen3-30b-a3b-instruct-2507
# Ollama alternative:
# LLM_BACKEND=ollama
# LLM_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# PIPER_VOICE=models/zh_CN-huayan-medium.onnx
SEARXNG_URL=http://127.0.0.1:8888
USER_LOCATION=上海
# Thinking models in LM Studio: "none" disables reasoning (2-3x faster)
LLM_REASONING_EFFORT=none
